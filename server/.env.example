# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/buildfolio

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars
REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ── AI — Gemini ───────────────────────────────────────────────────────────────
# Required. Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# ── Logging ───────────────────────────────────────────────────────────────────
# Values: debug | info | warn | error (default: info in prod, debug in dev)
LOG_LEVEL=debug

# ── Cloudinary (optional — profile images) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET_KEY=your_secret_key

# ── Legacy Python backend (no longer required with Gemini) ────────────────────
# PYTHON_API_URL=http://127.0.0.1:8000

# ── Vector DB (activate when ready — see src/vector/) ────────────────────────
# VECTOR_PROVIDER=pinecone
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_INDEX=buildfolio-resumes
# PINECONE_ENVIRONMENT=us-east-1

# VECTOR_PROVIDER=weaviate
# WEAVIATE_URL=https://your-cluster.weaviate.network
# WEAVIATE_API_KEY=your_weaviate_key
